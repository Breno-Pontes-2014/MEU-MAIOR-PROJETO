# Ambiente do Hotel Master / SaaS
FLASK_SECRET_KEY=gere-uma-chave-aleatoria-forte
JWT_SECRET=gere-outra-chave-aleatoria-forte
SAAS_ADMIN_TOKEN=gere-um-token-administrativo-forte

# PostgreSQL (produção)
DATABASE_URL=postgresql://usuario:senha@host:5432/hotel_master

HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
FORCE_HTTPS=1
SESSION_COOKIE_SECURE=1

# Google Maps Platform / Places API
GOOGLE_MAPS_API_KEY=sua-chave-google-maps-restrita

# Asaas — cobrança recorrente e webhook
ASAAS_API_KEY=sua-access-token-asaas
ASAAS_WEBHOOK_TOKEN=token-do-webhook-asaas
SAAS_PUBLIC_URL=https://seu-dominio.com.br

# Opcional: URL de checkout já existente
# SAAS_CHECKOUT_URL=https://asaas.com/checkoutSession/show?id=...
