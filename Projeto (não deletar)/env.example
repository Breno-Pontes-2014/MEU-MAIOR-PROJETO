# Ambiente do Hotel Master / SaaS
APP_ENV=development
FLASK_SECRET_KEY=SUBSTITUA_POR_SEGREDO_FORTE_1
JWT_SECRET=SUBSTITUA_POR_SEGREDO_FORTE_2
SAAS_ADMIN_INITIAL_USERNAME=Administrado
SAAS_ADMIN_INITIAL_PASSWORD=
# Custo médio de aquisição por hotel (R$), usado no LTV/CAC do painel SaaS.
SAAS_CAC_ESTIMADO=

# PostgreSQL (produção)
DATABASE_URL=

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
FORCE_HTTPS=0
SESSION_COOKIE_SECURE=0
SAAS_TIMEZONE_OFFSET=-03:00

# Geoapify — Geocoding no servidor e mapa estático no navegador.
GEOAPIFY_API_KEY=
# Chave pública do mapa: crie uma chave separada e restrinja por HTTP referrer/domínio.
GEOAPIFY_MAPS_API_KEY=

# Asaas — cobrança recorrente e webhook
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox
SAAS_PUBLIC_URL=

# WhatsApp Business Cloud API — ordens de serviço para funcionários
# O número do hotel e os telefones da equipe são cadastrados no painel.
# Configure as credenciais reais no ambiente do servidor; nunca as publique no repositório.
WHATSAPP_CLOUD_API_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=
# Opcional, mas recomendado para avisos iniciados pelo hotel fora da janela de atendimento.
# O modelo aprovado precisa ter 7 variáveis {{1}}...{{7}} na ordem definida no app.py.
WHATSAPP_CLOUD_API_TEMPLATE_NAME=
WHATSAPP_CLOUD_API_TEMPLATE_LANGUAGE=pt_BR

# Opcional: URL de checkout já existente
# SAAS_CHECKOUT_URL=https://asaas.com/checkoutSession/show?id=...
